# Default deny: only reviewed source/configuration/documentation is tracked.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/README.md
!/OPENAI.md
!/VOSK.md
!/VPN-REPAIR.md
!/Dockerfile
!/build.sh
!/fetch-model.sh
!/gpt-live
!/vosk-live
!/vosk-test
!/vosk-stream.c
!/vosk-transcribe.c
!/S98mini3wg.v2
!/mini3-dhcpcd.exit-hook
!/mini3-openai/
/mini3-openai/*
!/mini3-openai/go.mod
!/mini3-openai/*.go
!/docs/
/docs/*
!/docs/*.md
!/buildtools/
/buildtools/*
!/buildtools/*.go
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/THIRD_PARTY.md
!/config/
/config/*
!/config/*.example
!/tests/
/tests/*
!/tests/*.sh
# Never commit credentials, recordings or device backups.
**/.env
**/*key.txt
**/wg0.conf
**/network.conf
**/*.local
**/.env.*
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/authorized_keys
**/*.wav
**/*.pcm
**/*.log
